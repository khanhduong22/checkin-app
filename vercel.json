{
    "alias": [
        "checkin-lim-art.vercel.app"
    ],
    "redirects": [
        {
            "source": "/(.*)",
            "destination": "https://limart.khanhdp.com/$1",
            "permanent": false
        }
    ],
    "crons": [
        {
            "path": "/api/cron/birthday-bonus",
            "schedule": "0 18 * * *"
        },
        {
            "path": "/api/cron/payroll-close",
            "schedule": "0 17 * * *"
        }
    ]
}